<?xml version="1.0" encoding="utf-8"?>
<!--
  DiagnoseWithAI.xaml
  -------------------
  Calls the PipelineGuard Cloud Run API (/api/diagnose) and returns structured
  diagnosis JSON.  Called by Main.xaml Step 2.

  In:  in_project     (String) — GitLab project path, e.g. "myorg/backend"
       in_pipelineId  (String) — Pipeline ID as string
       in_apiBaseUrl  (String) — PipelineGuard Cloud Run URL

  Out: out_diagnosisJson (String) — raw JSON response from /api/diagnose
-->
<Activity mc:Ignorable="sap2010 sads sann"
          x:Class="PipelineGuardMaestro.DiagnoseWithAI"
          xmlns="http://schemas.microsoft.com/netfx/2009/xaml/activities"
          xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
          xmlns:sads="http://schemas.microsoft.com/netfx/2010/xaml/activities/debugger"
          xmlns:sann="http://schemas.uipath.com/workflow/annotations"
          xmlns:sap2010="http://schemas.microsoft.com/netfx/2010/xaml/activities/presentation"
          xmlns:ui="http://schemas.uipath.com/workflow/activities"
          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Activity.Properties>
    <Property Name="in_project"        Type="InArgument(x:String)" />
    <Property Name="in_pipelineId"     Type="InArgument(x:String)" />
    <Property Name="in_apiBaseUrl"     Type="InArgument(x:String)" />
    <Property Name="out_diagnosisJson" Type="OutArgument(x:String)" />
  </Activity.Properties>

  <Sequence DisplayName="Call PipelineGuard /api/diagnose">

    <Sequence.Variables>
      <Variable x:TypeArguments="x:String" Name="requestBody"  />
      <Variable x:TypeArguments="x:String" Name="responseBody" />
      <Variable x:TypeArguments="x:Int32"  Name="statusCode"   />
      <Variable x:TypeArguments="x:String" Name="endpoint"     />
    </Sequence.Variables>

    <Assign DisplayName="Build JSON request body">
      <Assign.To><OutArgument x:TypeArguments="x:String">[requestBody]</OutArgument></Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:String">
          ["{""project"":""" &amp; in_project &amp; """,""pipeline_id"":" &amp; in_pipelineId &amp; "}"]
        </InArgument>
      </Assign.Value>
    </Assign>

    <Assign DisplayName="Build endpoint URL">
      <Assign.To><OutArgument x:TypeArguments="x:String">[endpoint]</OutArgument></Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:String">[in_apiBaseUrl &amp; "/api/diagnose"]</InArgument>
      </Assign.Value>
    </Assign>

    <ui:HTTPRequest DisplayName="POST /api/diagnose (Gemini 2.5 Flash diagnosis)"
                    EndPoint="[endpoint]"
                    Method="POST"
                    Body="[requestBody]"
                    Response="[responseBody]"
                    ResponseStatusCode="[statusCode]">
      <ui:HTTPRequest.Headers>
        <x:Array Type="ui:HttpHeader">
          <ui:HttpHeader Key="Content-Type" Value="application/json" />
          <ui:HttpHeader Key="Accept"       Value="application/json" />
        </x:Array>
      </ui:HTTPRequest.Headers>
    </ui:HTTPRequest>

    <If DisplayName="Check HTTP 2xx" Condition="[statusCode &lt; 200 OrElse statusCode &gt;= 300]">
      <If.Then>
        <Throw DisplayName="Throw on HTTP error">
          <Throw.Exception>
            <InArgument x:TypeArguments="x:Exception">
              [New System.Exception("PipelineGuard /api/diagnose returned HTTP " &amp; statusCode.ToString())]
            </InArgument>
          </Throw.Exception>
        </Throw>
      </If.Then>
    </If>

    <Assign DisplayName="Pass response to caller">
      <Assign.To><OutArgument x:TypeArguments="x:String">[out_diagnosisJson]</OutArgument></Assign.To>
      <Assign.Value><InArgument x:TypeArguments="x:String">[responseBody]</InArgument></Assign.Value>
    </Assign>

    <ui:LogMessage Level="Information"
                   DisplayName="Log: diagnosis complete"
                   Message="[&quot;[PipelineGuard] Diagnosis received (&quot; &amp; responseBody.Length.ToString() &amp; &quot; chars)&quot;]" />

  </Sequence>
</Activity>
